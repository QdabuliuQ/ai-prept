# 复制为 backend/.env，或直接使用仓库根 .env.local

# 官方 DeepSeek（Admin / CLI 默认主力 + Plan）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-key
# 多 key 轮询（推荐 4 个）：sk-a,sk-b,sk-c,sk-d
# LLM_API_KEYS=sk-a,sk-b,sk-c,sk-d
LLM_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=  # 可选；与 LLM_* 二选一或并存（Admin「DeepSeek」优先读这两个）
# DEEPSEEK_API_KEYS=
# DeepSeek / Gemini 思考：未设置时默认关；Admin「LLM 思考模式」按任务注入 LLM_THINKING
# DeepSeek → thinking enabled/disabled；Gemini → reasoning_effort high / minimal|low
# 需要时显式 LLM_THINKING=1（或 Admin 打开开关）
# LLM_THINKING=0
# Qwen3 默认关思考（选主题/Plan 非流式否则易卡死）；需要思考时设 1
# LLM_QWEN_THINKING=0

# 轻量模型（Plan JSON；默认 DeepSeek）
# LLM_LIGHT_ENABLED=1
# LLM_LIGHT_SAME=0
# LLM_LIGHT_BASE_URL=https://api.deepseek.com
# LLM_LIGHT_MODEL=deepseek-v4-flash
# LLM_LIGHT_API_KEY=
# LLM_LIGHT_API_KEYS=

# 商汤 SenseNova（可选；Admin 手动切换）
# SENSENOVA_API_KEY=sk-your-sensenova-key
# SENSENOVA_API_KEYS=sk-a,sk-b
# SENSENOVA_BASE_URL=https://token.sensenova.cn/v1

# 硅基流动（Admin 切换 Qwen；进程注入的 LLM_* 优先于本文件）
# 单 key / 多 key 轮询（与 DeepSeek LLM_API_KEYS 相同）：
# SILICONFLOW_API_KEY=sk-your-siliconflow-key
# SILICONFLOW_API_KEYS=sk-a,sk-b,sk-c,sk-d

# 魔塔社区 ModelScope（OpenAI 兼容；Admin「魔塔社区」）
# https://api-inference.modelscope.cn/v1/chat/completions
# Token：https://modelscope.cn/my/myaccesstoken
# MODELSCOPE_API_TOKEN=ms-your-token
# MODELSCOPE_API_KEY=ms-your-token
# MODELSCOPE_API_KEYS=ms-a,ms-b
# LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Google Gemini（OpenAI 兼容；Admin「Google Gemini」）
# https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_API_KEYS=key1,key2
# GOOGLE_API_KEY=
# 模型：gemini-3.8-flash（另有 gemini-3.5-flash-lite / gemini-3.1-flash / gemini-3.1-flash-lite）
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Groq（OpenAI 兼容；Admin / 首页「Groq」）
# https://api.groq.com/openai/v1/chat/completions
# GROQ_API_KEY=gsk_your-groq-key
# GROQ_API_KEYS=gsk_a,gsk_b
# 模型：qwen/qwen3.8-27b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# FreeShare（OpenAI 兼容；Admin「FreeShare」）
# https://freeshare.cc.cd/v1/chat/completions
# FREESHARE_API_KEY=sk-your-freeshare-key
# FREESHARE_API_KEYS=sk-a,sk-b
# 模型：agnes-3.0-flash
# FREESHARE_BASE_URL=https://freeshare.cc.cd/v1

# Cloudflare Workers AI（直连 /ai/run/@cf/...，用免费神经元；勿用 AI Gateway）
# POST https://api.cloudflare.com/client/v4/accounts/{ACCOUNT_ID}/ai/run/@cf/...
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=cfut_your-token
# CLOUDFLARE_API_TOKENS=cfut_a,cfut_b
# 后台可选：@cf/moonshotai/kimi-k2.7-code / @cf/qwen/qwen2.5-coder-32b-instruct
# 勿选 alibaba/*（会进 AI Gateway 统一计费 → 402）
# 注意：alibaba/qwen3.7-max 属第三方模型，会走 AI Gateway 统一计费（402）

# Pollinations.ai（Admin 可切文本 + 文生图）
# POLLINATIONS_API_KEY=your-pollinations-key
# POLLINATIONS_API_KEYS=key1,key2
# POLLINATIONS_BASE_URL=https://gen.pollinations.ai

# 单次请求超时（秒）/ 应用层重试次数 / SDK 内置重试
# LLM_TIMEOUT=180
# LLM_ATTEMPTS=3
# LLM_SDK_RETRIES=1
# 单包内页 HTML 并行数（默认 3；过大易把长请求拖死）
# AGENT_SLIDE_CONCURRENCY=3
# Plan 精修：轻量出骨架后，重模型只重写封面（多一次调用）
# AGENT_PLAN_REFINE=1
# AGENT_PLAN_REFINE=0
# 精修范围：cover（默认仅封面）| heroes（含章节/收尾）
# AGENT_PLAN_REFINE_SCOPE=cover
# 质检硬失败后按页重修轮数（默认 1；0=关闭；最多 3）
# AGENT_REPAIR_ROUNDS=1
# AGENT_REPAIR_ROUNDS=0
# 质检硬失败后把可迁移规则追加到 excerpts/LEARNED_LESSONS.md（默认开；0=关）
# AGENT_LEARN_LESSONS=1
# AGENT_LEARN_LESSONS=0

# 文生图（OpenAI images 兼容 / 硅基流动 / Pollinations GET）
# IMAGE_API_PROVIDER=openai
# IMAGE_API_PROVIDER=siliconflow
# IMAGE_API_PROVIDER=pollinations
# IMAGE_API_BASE_URL=https://www.maizitech.xyz/v1
# IMAGE_API_BASE_URL=https://api.siliconflow.cn/v1
# IMAGE_API_KEY=
# IMAGE_API_KEYS=
# 硅基流动文生图也可直接用 SILICONFLOW_API_KEY(S)（与上方 LLM 共用）
# IMAGE_MODEL=nano-banana-fast
# IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo
# IMAGE_MODEL=Kwai-Kolors/Kolors
# IMAGE_MODEL=Qwen/Qwen-Image
# IMAGE_MODEL=flux
# IMAGE_TIMEOUT=180
# IMAGE_SDK_RETRIES=1
# 主线路生图失败时回退硅基流动（需 SILICONFLOW_API_KEY(S)；默认开）
# IMAGE_FALLBACK_SILICONFLOW=1
# IMAGE_FALLBACK_SILICONFLOW=0
# IMAGE_FALLBACK_SILICONFLOW_MODEL=Tongyi-MAI/Z-Image-Turbo

# 风格意图自动建卡（Admin「风格意图」+ --ensure-style）；设 0 可全局关闭
# AGENT_STYLE_AUTOCREATE=1
# AGENT_STYLE_AUTOCREATE=0

# Plan 后 palette 对比度精修（colorspacious/WCAG；默认关；Admin 开关 / --palette-refine）
# AGENT_PALETTE_REFINE=0
# AGENT_PALETTE_REFINE=1

# DOM_TO_PPTX_SKILL_ROOT=
# AGENT_MOCK=0
