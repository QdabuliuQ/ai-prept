{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./frontend/src/*"],
      "@webppt/html-to-pptx": ["./packages/html-to-pptx/src/index.ts"],
      "@webppt/html-to-pptx/*": ["./packages/html-to-pptx/src/*"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "frontend/**/*.ts",
    "frontend/**/*.tsx",
    "packages/html-to-pptx/src/**/*.ts"
  ],
  "exclude": ["node_modules", "frontend/dist", "backend"]
}
