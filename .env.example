# 复制为 .env.local（Vite 前端 + Python 后端共用）

# ========== DeepSeek LLM（官方 API；Admin / CLI 默认）==========
LLM_BASE_URL=https://api.deepseek.com
# 单 key：
LLM_API_KEY=sk-your-deepseek-key
# 多 key（逗号分隔，轮询分摊限流；可与 LLM_API_KEY 同时写，会去重合并）：
# LLM_API_KEYS=sk-key1,sk-key2,sk-key3,sk-key4
LLM_MODEL=deepseek-v4-flash
# 可选专用 DeepSeek key（Admin「DeepSeek」优先于上面的 LLM_*）
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_KEYS=

# ========== 商汤 SenseNova（可选；Admin 手动切换）==========
# https://token.sensenova.cn/v1/chat/completions
# 模型：sensenova-6.8-flash-lite / sensenova-u1.5-lite / sensenova-u1.5-fast
#       deepseek-v4-flash / deepseek-flash / glm-5.2 / kimi-k3
# SENSENOVA_API_KEY=sk-your-sensenova-key
# SENSENOVA_API_KEYS=sk-a,sk-b
# SENSENOVA_BASE_URL=https://token.sensenova.cn/v1

# ========== 硅基流动（轻量 Plan 兜底）==========
# https://api.siliconflow.cn/v1/chat/completions
# 有 Key 时可作为 Plan 兜底；Theme/SVG 默认仍用 DeepSeek
# 单 key：
# SILICONFLOW_API_KEY=sk-your-siliconflow-key
# 多 key（逗号分隔轮询，与 DeepSeek 的 LLM_API_KEYS 相同用法）：
SILICONFLOW_API_KEYS=sk-key1,sk-key2,sk-key3,sk-key4
# 可选显式轻量模型：
# LLM_LIGHT_MODEL=Qwen/Qwen3-8B
# LLM_LIGHT_ENABLED=1

# ========== 魔塔社区 ModelScope（Admin 可切）==========
# OpenAI 兼容：https://api-inference.modelscope.cn/v1
# Token：https://modelscope.cn/my/myaccesstoken
# MODELSCOPE_API_TOKEN=ms-your-token
# MODELSCOPE_API_KEY=ms-your-token
# MODELSCOPE_API_KEYS=ms-a,ms-b
# 模型：deepseek-ai/DeepSeek-V4.1-Flash

# ========== Google Gemini（OpenAI 兼容；Admin「Google Gemini」）==========
# https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# Key：https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_API_KEYS=key1,key2
# 可选：GOOGLE_API_KEY= / GOOGLE_AI_API_KEY=
# 默认模型：gemini-3.8-flash（另有 gemini-3.5-flash-lite / gemini-3.1-flash / gemini-3.1-flash-lite）
# 可选覆盖：
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ========== Groq（OpenAI 兼容；Admin / 首页「Groq」）==========
# https://api.groq.com/openai/v1/chat/completions
# Key：https://console.groq.com/keys
# GROQ_API_KEY=gsk_your-groq-key
# GROQ_API_KEYS=gsk_a,gsk_b
# 默认模型：qwen/qwen3.8-27b
# 可选覆盖：
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ========== FreeShare（OpenAI 兼容；Admin「FreeShare」）==========
# https://freeshare.cc.cd/v1/chat/completions
# FREESHARE_API_KEY=sk-your-freeshare-key
# FREESHARE_API_KEYS=sk-a,sk-b
# 默认模型：agnes-3.0-flash
# 可选覆盖：
# FREESHARE_BASE_URL=https://freeshare.cc.cd/v1

# ========== WorkBuddy 本机桥（OpenAI 兼容；Admin「WorkBuddy (本机)」）==========
# 需先启动 workbuddy-bridge：http://127.0.0.1:3000/v1/chat/completions
# WORKBUDDY_API_KEY=any
# WORKBUDDY_API_KEYS=any
# 默认模型：workbuddy
# 可选：hy4-preview-f / hy3 / hy3-x / space-bunny
#       deepseek-v4.1-flash / deepseek-v4-pro
#       glm-5.3 / glm-5.3-flash / glm-5.2 / glm-5.1 / glm-5v-turbo
#       minimax-m3 / minimax-m2.7
#       kimi-k3-1 / kimi-k2.8-preview / kimi-k2.7 / kimi-k2.6
# 可选覆盖：
# WORKBUDDY_BASE_URL=http://127.0.0.1:3000/v1

# ========== Cloudflare Workers AI（直连 /ai/run，免费神经元）==========
# https://api.cloudflare.com/client/v4/accounts/{ACCOUNT_ID}/ai/run/@cf/...
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# 单 token：
# CLOUDFLARE_API_TOKEN=cfut_your-token
# 多 token：
# CLOUDFLARE_API_TOKENS=cfut_a,cfut_b
# 推荐：@cf/moonshotai/kimi-k2.7-code（另有 @cf/qwen/qwen2.5-coder-32b-instruct）
# 勿选 alibaba/*（会进 AI Gateway 统一计费 → 402）

# ========== Pollinations.ai（文本 OpenAI 兼容 + 文生图 GET）==========
# https://gen.pollinations.ai/v1/chat/completions
# https://gen.pollinations.ai/image/{prompt}
# POLLINATIONS_API_KEY=your-pollinations-key
# POLLINATIONS_API_KEYS=key1,key2
# 可选覆盖根地址（默认 https://gen.pollinations.ai；文本会自动补 /v1）
# POLLINATIONS_BASE_URL=https://gen.pollinations.ai

# 风格意图自动建卡（Admin 填「风格意图」时）；全局关：AGENT_STYLE_AUTOCREATE=0
# AGENT_STYLE_AUTOCREATE=1

# Plan 后 palette 对比度精修（默认关；Admin 开关 / --palette-refine）
# AGENT_PALETTE_REFINE=0
# AGENT_PALETTE_REFINE=1

# 页并行；不设则默认 3（上限 8）
# AGENT_SLIDE_CONCURRENCY=3
# 质检硬失败后按页重修（默认 1；0=关）
# AGENT_REPAIR_ROUNDS=1

# Python 后端可选
# DOM_TO_PPTX_SKILL_ROOT=
# AGENT_MOCK=1
# AGENT_SKIP_IMAGE=1

# ========== 文生图 ==========
# 提供方：openai（Maizi 等 OpenAI images 兼容）| pollinations
# IMAGE_API_PROVIDER=openai
# IMAGE_API_PROVIDER=pollinations
IMAGE_API_BASE_URL=https://your-image-api/v1
IMAGE_API_KEY=sk-your-image-apikey
# IMAGE_API_KEYS=sk-img1,sk-img2
IMAGE_MODEL=nano-banana-fast
# Pollinations 时常用：flux / turbo / gptimage / nanobanana …
# IMAGE_MODEL=flux
IMAGE_ASPECT_RATIO=auto
# AGENT_IMAGE_CONCURRENCY=4

# ========== SCORE_VL（Admin 随机主题等轻量调用，OpenAI 兼容）==========
# 例：阿里云 DashScope compatible-mode
# SCORE_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# SCORE_VL_MODEL=qwen-vl-max
# SCORE_VL_API_KEY=
# 或使用 DASHSCOPE_API_KEY=

# ========== 模板后台 /admin ==========
# 访问 http://localhost:5174/admin ，用此 token 登录
ADMIN_TOKEN=change-me-admin-token

# 模板存储后端：local（默认）| oss（后续）
# TEMPLATE_STORAGE=local

# ========== 前端（Vite）+ 后端 API（Python）==========
# Vite 代理 /api 与 /embed 到该地址
# GALLERY_API_URL=http://127.0.0.1:8787
# DATABASE_URL=postgresql://webppt:webppt@127.0.0.1:5433/webppt
# PPTX→HTML：browser（默认，Admin 页内转换）| puppeteer（旧版无头 Chrome）
# WEBPPT_HTML_CONVERT=browser
# 后端：cd backend && pip install -e '.[api]' && webppt-backend serve
# 前端：npm run dev

# ========== 七牛云（管理端「上传」：压缩图片 → zip → Kodo）==========
# QINIU_ACCESS_KEY=
# QINIU_SECRET_KEY=
# QINIU_BUCKET=your-bucket
# 公开访问域名（含 https://，无末尾斜杠）
# QINIU_DOMAIN=https://cdn.example.com
# 对象 key 前缀（默认 webppt/）
# QINIU_KEY_PREFIX=webppt/
# 可选机房：z0 | z1 | z2 | na0 | as0 | cn-east-2（不填则自动探测）
# QINIU_REGION=z0
# 仅 WEBPPT_HTML_CONVERT=puppeteer 时需要；或旧截图路径
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
