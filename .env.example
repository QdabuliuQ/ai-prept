# 复制为 .env.local（Next.js + Python agent 共用）

# ========== DeepSeek LLM（官方 API；Admin / CLI 默认）==========
LLM_BASE_URL=https://api.deepseek.com
# 单 key：
LLM_API_KEY=sk-your-deepseek-key
# 多 key（逗号分隔，轮询分摊限流；可与 LLM_API_KEY 同时写，会去重合并）：
# LLM_API_KEYS=sk-key1,sk-key2,sk-key3,sk-key4
LLM_MODEL=deepseek-v4-flash
# 可选专用 DeepSeek key（Admin「DeepSeek」优先于上面的 LLM_*）
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_KEYS=

# ========== 商汤 SenseNova（可选；Admin 手动切换）==========
# https://token.sensenova.cn/v1/chat/completions
# SENSENOVA_API_KEY=sk-your-sensenova-key
# SENSENOVA_API_KEYS=sk-a,sk-b
# SENSENOVA_BASE_URL=https://token.sensenova.cn/v1

# ========== 硅基流动（轻量 Plan 兜底）==========
# https://api.siliconflow.cn/v1/chat/completions
# 有 Key 时可作为 Plan 兜底；Theme/SVG 默认仍用 DeepSeek
# 单 key：
# SILICONFLOW_API_KEY=sk-your-siliconflow-key
# 多 key（逗号分隔轮询，与 DeepSeek 的 LLM_API_KEYS 相同用法）：
SILICONFLOW_API_KEYS=sk-key1,sk-key2,sk-key3,sk-key4
# 可选显式轻量模型：
# LLM_LIGHT_MODEL=Qwen/Qwen3-8B
# LLM_LIGHT_ENABLED=1

# ========== Cloudflare Workers AI（直连 /ai/run，免费神经元）==========
# https://api.cloudflare.com/client/v4/accounts/{ACCOUNT_ID}/ai/run/@cf/...
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# 单 token：
# CLOUDFLARE_API_TOKEN=cfut_your-token
# 多 token：
# CLOUDFLARE_API_TOKENS=cfut_a,cfut_b
# 推荐：@cf/qwen/qwen2.5-coder-32b-instruct
# 勿选 alibaba/*（会进 AI Gateway 统一计费 → 402）

# ========== Pollinations.ai（文本 OpenAI 兼容 + 文生图 GET）==========
# https://gen.pollinations.ai/v1/chat/completions
# https://gen.pollinations.ai/image/{prompt}
# POLLINATIONS_API_KEY=your-pollinations-key
# POLLINATIONS_API_KEYS=key1,key2
# 可选覆盖根地址（默认 https://gen.pollinations.ai；文本会自动补 /v1）
# POLLINATIONS_BASE_URL=https://gen.pollinations.ai

# 风格意图自动建卡（Admin 填「风格意图」时）；全局关：AGENT_STYLE_AUTOCREATE=0
# AGENT_STYLE_AUTOCREATE=1

# Plan 后 palette 对比度精修（默认关；Admin 开关 / --palette-refine）
# AGENT_PALETTE_REFINE=0
# AGENT_PALETTE_REFINE=1

# 页并行；不设则约 = keys×2（上限 9）
# AGENT_SLIDE_CONCURRENCY=8
# 质检硬失败后按页重修（默认 1；0=关）
# AGENT_REPAIR_ROUNDS=1

# Python agent 可选
# DOM_TO_PPTX_SKILL_ROOT=
# AGENT_MOCK=1
# AGENT_SKIP_IMAGE=1

# ========== 文生图 ==========
# 提供方：openai（Maizi 等 OpenAI images 兼容）| pollinations
# IMAGE_API_PROVIDER=openai
# IMAGE_API_PROVIDER=pollinations
IMAGE_API_BASE_URL=https://your-image-api/v1
IMAGE_API_KEY=sk-your-image-apikey
# IMAGE_API_KEYS=sk-img1,sk-img2
IMAGE_MODEL=nano-banana-fast
# Pollinations 时常用：flux / turbo / gptimage / nanobanana …
# IMAGE_MODEL=flux
IMAGE_ASPECT_RATIO=auto
# AGENT_IMAGE_CONCURRENCY=4

# ========== SCORE_VL（Admin 随机主题等轻量调用，OpenAI 兼容）==========
# 例：阿里云 DashScope compatible-mode
# SCORE_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# SCORE_VL_MODEL=qwen-vl-max
# SCORE_VL_API_KEY=
# 或使用 DASHSCOPE_API_KEY=

# ========== 模板后台 /admin ==========
# 访问 http://localhost:5174/admin ，用此 token 登录
ADMIN_TOKEN=change-me-admin-token

# 模板存储后端：local（默认）| oss（后续）
# TEMPLATE_STORAGE=local

# ========== 七牛云（管理端「上传」：压缩图片 → zip → Kodo）==========
# QINIU_ACCESS_KEY=
# QINIU_SECRET_KEY=
# QINIU_BUCKET=your-bucket
# 公开访问域名（含 https://，无末尾斜杠）
# QINIU_DOMAIN=https://cdn.example.com
# 对象 key 前缀（默认 webppt/）
# QINIU_KEY_PREFIX=webppt/
# 可选机房：z0 | z1 | z2 | na0 | as0 | cn-east-2（不填则自动探测）
# QINIU_REGION=z0
# 上传时截预览图用的 Chrome（可选；不填则尝试系统 Chrome / Puppeteer 自带）
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
